# ---------------------------------------------------------------
# DESCO Attendance — configuration template
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
# ---------------------------------------------------------------

# --- Ports exposed on the Docker host ---------------------------
APP_PORT=3000
DB_PORT=5433
ADMINER_PORT=8080

# --- PostgreSQL -------------------------------------------------
POSTGRES_USER=desco
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=desco_attendance

# Used only when running `npm run dev` on the host against the
# containerised database. Inside Docker the host is `db`, not localhost.
DATABASE_URL=postgresql://desco:change_me_strong_password@localhost:5433/desco_attendance?schema=public

# --- Security ---------------------------------------------------
# REQUIRED. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Locale / policy defaults -----------------------------------
APP_TIMEZONE=Asia/Dhaka
APP_COUNTRY=BD

# Set to false if the app is NOT behind a trusted reverse proxy.
# When true, X-Forwarded-For is honoured for client IP resolution.
TRUST_PROXY=true

# --- IP intelligence (VPN / proxy detection) --------------------
# Optional. Leave blank to use the free, keyless ip-api.com fallback.
# Provider priority: proxycheck.io > ipinfo.io > ip-api.com
PROXYCHECK_KEY=
IPINFO_TOKEN=

# --- Seeding ----------------------------------------------------
# Runs the idempotent seed on every container boot. Set to false in production
# once the real employee roster has been imported.
SEED_ON_BOOT=true

# --- Cookies ----------------------------------------------------
# Leave BLANK to auto-detect from x-forwarded-proto. Do NOT force this to true
# unless TLS actually terminates in front of the app: a Secure cookie is
# silently dropped on http://localhost and on LAN addresses, which makes login
# appear to succeed while every later request arrives anonymous.
#   true  = always mark cookies Secure (behind HTTPS)
#   false = never (plain HTTP testing on a LAN IP, e.g. a phone)
COOKIE_SECURE=
