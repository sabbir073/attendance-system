# ---------- dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ---------- next.js ----------
/.next/
/out/
next-env.d.ts
.turbo/

# ---------- production ----------
/build
/dist

# ---------- prisma ----------
# Generated client is rebuilt by `prisma generate` on every install/build.
/src/generated/
/prisma/migrations/dev.db*

# ---------- secrets ----------
# NEVER commit these. .env.example is the committed template.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ---------- logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# ---------- testing / coverage ----------
/coverage
.nyc_output

# ---------- editors ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---------- os ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- misc ----------
*.tsbuildinfo
.vercel
.cache/
